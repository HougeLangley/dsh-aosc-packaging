{
  "name": "dsh-aosc-packaging",
  "version": "0.1.1",
  "description": "AOSC OS packaging toolkit for DeepSeek Harness: inspect, lint, scaffold and plan .deb packages built with ABBS, Autobuild4 and Ciel.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "skills",
    "docs",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0-0" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "aosc", "aosc-os", "abbs", "autobuild", "packaging", "deb"],
  "license": "MIT",
  "author": "HougeLangley",
  "repository": { "type": "git", "url": "git+https://github.com/HougeLangley/dsh-aosc-packaging.git" },
  "homepage": "https://github.com/HougeLangley/dsh-aosc-packaging#readme",
  "bugs": { "url": "https://github.com/HougeLangley/dsh-aosc-packaging/issues" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": { "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-tools": { "optional": true } },
  "scripts": { "test": "node --test \"tests/**/*.test.mjs\"" }
}
